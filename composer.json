{
    "name": "bonsaicms/settings",
    "type": "package",
    "description": "Settings manager for Laravel",
    "authors": [
        {
            "name": "Matej Vitaz",
            "email": "mspiderv@gmail.com"
        }
    ],
    "keywords": [
        "settings",
        "Bonsai CMS",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "BonsaiCms\\Settings\\": "src/BonsaiCms/Settings/"
        },
        "files": [
            "helpers/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "BonsaiCms\\Settings\\SettingsServiceProvider"
            ],
            "aliases": {
                "Settings": "BonsaiCms\\Settings\\Facades\\Settings"
            }
        }
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^4.0",
        "predis/predis": "^2.0",
        "larastan/larastan": "^3.11"
    },
    "suggest": {
        "predis/predis": "Required by the redis settings driver, unless the phpredis extension is installed.",
        "ext-redis": "Required by the redis settings driver, unless predis/predis is installed."
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "scripts-descriptions": {
        "test": "Run the Pest suite against the driver SETTINGS_DRIVER names.",
        "analyse": "Run PHPStan over the package."
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}

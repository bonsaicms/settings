{
    "name": "bonsaicms/settings",
    "type": "package",
    "description": "Settings manager for Laravel",
    "authors": [
        {
            "name": "Matej Vitaz",
            "email": "mspiderv@gmail.com"
        }
    ],
    "keywords": [
        "settings",
        "Bonsai CMS",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "BonsaiCms\\Settings\\": "src/BonsaiCms/Settings/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "BonsaiCms\\Settings\\SettingsServiceProvider"
            ],
            "aliases": {
                "Settings": "BonsaiCms\\Settings\\SettingsFacade"
            }
        }
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^4.0"
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}

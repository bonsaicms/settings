# Store every text file with LF in the repository, and check it out with LF as
# well, so line endings do not depend on each contributor's core.autocrlf.
* text=auto eol=lf

# Keep the dist archive (what `composer require --prefer-dist` downloads) to
# what the package needs at runtime. README and LICENSE stay in on purpose.
/.github            export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/CLAUDE.md          export-ignore
/phpunit.xml        export-ignore
/tests              export-ignore
